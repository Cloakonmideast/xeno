generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String        @id @default(uuid())
  name               String?
  shopDomain         String        @unique
  privateToken       String         // <--- Updated field name
  createdAt          DateTime      @default(now())

  customers   Customer[]
  products    Product[]
  orders      Order[]
  events      Event[]
  tenantUsers TenantUser[]
}


model User {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  tenants   TenantUser[]
}

model TenantUser {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenantId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String   @default("owner")

  @@unique([tenantId, userId])
}

model Customer {
  id                BigInt   @id @default(autoincrement())
  tenantId          String
  shopifyCustomerId BigInt
  email             String?
  firstName         String?
  lastName          String?
  totalSpent        Decimal   @default(0)
  createdAt         DateTime?
  updatedAt         DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  orders Order[]

  @@unique([tenantId, shopifyCustomerId])   // <--- REQUIRED
}

model Order {
  id              BigInt   @id @default(autoincrement())
  tenantId        String
  shopifyOrderId  BigInt
  customerId      BigInt?  // references Customer.id not shopifyCustomerId
  orderNumber     String?
  financialStatus String?
  totalPrice      Decimal
  currency        String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@unique([tenantId, shopifyOrderId])   // <--- REQUIRED
}

model Product {
  id              BigInt   @id @default(autoincrement())
  tenantId        String
  shopifyProductId BigInt
  title           String?
  sku             String?
  price           Decimal?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]

  @@unique([tenantId, shopifyProductId])   // <--- REQUIRED
}

model OrderItem {
  id        BigInt @id @default(autoincrement())
  orderId   BigInt
  productId BigInt?
  quantity  Int
  price     Decimal

  order   Order   @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])   // <--- REQUIRED
}


model Event {
  id                BigInt   @id @default(autoincrement())
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  tenantId          String
  shopifyCustomerId BigInt?
  eventType         String
  payload           Json
  occurredAt        DateTime @default(now())
}
